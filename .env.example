# Copy to .env.local and fill in. Read at build time (pnpm build), so rebuild after changing.

# Google Drive backup. Official builds use Doku Scan's own client id (built in).
# Set this only if you build and sign the app yourself with a different key:
# your own Google Cloud project's OAuth client id of type "Web application"
# (NOT the Android client id). See README "Google Drive backup".
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
